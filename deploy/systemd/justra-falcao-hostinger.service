[Unit]
Description=Justra Falcao Hostinger collector and Azure importer
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=justra
Group=justra
WorkingDirectory=/opt/justra/app
EnvironmentFile=/etc/justra/falcao-worker.env
ExecStart=/opt/justra/app/.venv/bin/python -u scripts/falcao_remote_worker.py
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/mnt/justra-data /mnt/justra-logs /opt/justra/app /tmp

[Unit]
Description=Justra remote PJe worker
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=justra
Group=justra
WorkingDirectory=/opt/justra/app
EnvironmentFile=/etc/justra/pje-worker.env
ExecStart=/opt/justra/app/.venv/bin/python -u scripts/pje_operator_agent.py --justra-url ${JUSTRA_PJE_BACKEND_URL} --operator-id ${JUSTRA_PJE_OPERATOR_ID} --headless --poll-seconds 10 --collector-timeout 180
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/mnt/justra-data /mnt/justra-logs /opt/justra/app

[Install]
WantedBy=multi-user.target

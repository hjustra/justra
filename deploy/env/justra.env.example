JUSTRA_ENV=staging
JUSTRA_PUBLIC_URL=https://staging.justra.example
JUSTRA_DATA_DIR=/mnt/justra-data
JUSTRA_LOG_DIR=/mnt/justra-logs

JUSTRA_ADMIN_EMAIL=admin@justra.local
JUSTRA_ADMIN_PASSWORD=change-me-before-start
JUSTRA_SIGNUPS_ENABLED=0
JUSTRA_PASSWORD_AUTH_ENABLED=0
JUSTRA_FREE_TOKEN_LIMIT=100000
JUSTRA_PREMIUM_PRICE_CENTS=9900

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
DATAJUD_API_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://staging.justra.example/api/auth/google/callback

JUSTRA_NODE_BIN=/usr/bin/node
JUSTRA_NODE_MODULES=/opt/justra/node-runtime/node_modules
JUSTRA_CHROME_PATH=
PLAYWRIGHT_BROWSERS_PATH=/opt/justra/node-runtime/browsers

[Unit]
Description=Justra Falcao persistent gov.br gold browser
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=justra
Group=justra
WorkingDirectory=/opt/justra/app
EnvironmentFile=/etc/justra/falcao-worker.env
Environment=FALCAO_AUTH_WAIT_MINUTES=0
ExecStart=/opt/justra/app/deploy/scripts/falcao_gold_login_session.sh
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=false
ProtectSystem=full
ReadWritePaths=/mnt/justra-data /mnt/justra-logs /home/justra /tmp

[Install]
WantedBy=multi-user.target

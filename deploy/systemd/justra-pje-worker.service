[Unit]
Description=Justra PJe worker
Wants=network-online.target justra.service
After=network-online.target justra.service

[Service]
Type=simple
User=justra
Group=justra
WorkingDirectory=/opt/justra/app
EnvironmentFile=/etc/justra/justra.env
ExecStart=/opt/justra/app/.venv/bin/python -u scripts/pje_operator_agent.py --justra-url http://127.0.0.1:8787 --headless --poll-seconds 10 --collector-timeout 180
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/mnt/justra-data /mnt/justra-logs /opt/justra/app

[Install]
WantedBy=multi-user.target
